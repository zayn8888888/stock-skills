{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventCalendarResult",
  "description": "前瞻事件日历 result.json 输出契约",
  "type": "object",
  "required": ["calendar_timestamp", "window", "data_sources_status", "events", "sources"],
  "properties": {
    "calendar_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "日历生成时点（UTC）"
    },
    "window": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date", "description": "起始日期 UTC" },
        "to": { "type": "string", "format": "date", "description": "截止日期 UTC" }
      }
    },
    "region": {
      "type": "string",
      "enum": ["US", "HK", "BOTH"]
    },
    "requested_symbols": {
      "type": "array",
      "items": { "type": "string" }
    },
    "data_sources_status": {
      "type": "object",
      "required": ["finnhub", "polymarket", "tavily"],
      "properties": {
        "finnhub": {
          "type": "object",
          "properties": {
            "available": { "type": "boolean" },
            "error": { "type": "string" }
          }
        },
        "polymarket": {
          "type": "object",
          "properties": {
            "available": { "type": "boolean" },
            "error": { "type": "string" }
          }
        },
        "tavily": {
          "type": "object",
          "properties": {
            "available": { "type": "boolean" },
            "error": { "type": "string" }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "主表事件列表",
      "items": {
        "type": "object",
        "required": ["date_utc", "event_name", "type", "source"],
        "properties": {
          "date_utc": { "type": "string", "format": "date" },
          "date_hkt": { "type": "string", "format": "date" },
          "event_name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "earnings",
              "economic_data",
              "monetary_policy",
              "fiscal_policy",
              "regulatory",
              "geopolitical",
              "industry",
              "other"
            ]
          },
          "affected_symbols": { "type": "array", "items": { "type": "string" } },
          "market_expectation": { "type": "string", "description": "市场预期值/共识值" },
          "implied_probability": {
            "type": "object",
            "properties": {
              "probability": { "type": "number", "minimum": 0, "maximum": 1 },
              "volume_24h_usd": { "type": "number" },
              "source": { "type": "string" }
            }
          },
          "source": { "type": "string" },
          "source_url": { "type": "string" },
          "is_outside_window": { "type": "boolean", "description": "是否窗口外但关键事件" },
          "actual": { "type": "string", "description": "已发布时的实际值，未发布为 null" }
        }
      }
    },
    "polymarket_highlights": {
      "type": "array",
      "description": "Polymarket 高流动性宏观押注 Top 5",
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "slug": { "type": "string" },
          "implied_probability": { "type": "number" },
          "volume_24h_usd": { "type": "number" },
          "url": { "type": "string" }
        }
      }
    },
    "economic_data_bets": {
      "type": "array",
      "description": "经济数据押注（vol24 > $50k）",
      "items": {
        "type": "object",
        "properties": {
          "indicator": { "type": "string" },
          "release_date": { "type": "string" },
          "consensus": { "type": "string" },
          "polymarket_implied": { "type": "number" },
          "volume_24h_usd": { "type": "number" }
        }
      }
    },
    "reference_cues": {
      "type": "array",
      "description": "参考线索（未确认日期）",
      "items": {
        "type": "object",
        "properties": {
          "event": { "type": "string" },
          "expected_window": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
