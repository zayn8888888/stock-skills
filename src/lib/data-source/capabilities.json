{
  "capabilities": [
    {
      "id": "cap_snapshot",
      "slug": "quote.snapshot",
      "category": "quote",
      "displayName": "实时报价",
      "description": "当前价格、涨跌幅、成交量等快照数据",
      "paramsSchema": {
        "type": "object",
        "properties": {
          "ticker": { "type": "string", "description": "股票代码，如 NVDA、00700、AAPL" },
          "market": {
            "type": "string",
            "description": "市场标识: HK(港股) US(美股) CN(沪深) CRYPTO"
          }
        },
        "required": ["ticker"]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "股票名称" },
          "curPrice": { "type": "number", "description": "当前价格（最新成交价）" },
          "highPrice": { "type": "number", "description": "今日最高价" },
          "lowPrice": { "type": "number", "description": "今日最低价" },
          "openPrice": { "type": "number", "description": "今日开盘价" },
          "lastClosePrice": { "type": "number", "description": "昨收价" },
          "volume": { "type": "number", "description": "成交量（股）" },
          "turnover": { "type": "number", "description": "成交额" },
          "turnoverRate": { "type": "number", "description": "换手率 (%)" },
          "amplitude": { "type": "number", "description": "振幅 (%)" },
          "pe": { "type": "number", "description": "市盈率 (TTM)" },
          "pb": { "type": "number", "description": "市净率" },
          "marketCap": { "type": "number", "description": "总市值" },
          "updateTime": { "type": "string", "description": "数据更新时间" },
          "isSuspended": { "type": "boolean", "description": "是否停牌" }
        },
        "required": ["curPrice"]
      }
    },
    {
      "id": "cap_kline",
      "slug": "quote.kline",
      "category": "kline",
      "displayName": "K线数据",
      "description": "历史/实时K线蜡烛图数据 (OHLCV)",
      "paramsSchema": {
        "type": "object",
        "properties": {
          "ticker": { "type": "string", "description": "股票代码" },
          "market": { "type": "string", "description": "市场标识" },
          "params": {
            "type": "object",
            "properties": {
              "num": { "type": "number", "description": "返回K线根数，默认30" },
              "klType": {
                "type": "number",
                "description": "K线类型: 1=1分 2=日 3=周 4=月 5=年 6=5分"
              }
            }
          }
        },
        "required": ["ticker"]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "ticker": { "type": "string", "description": "股票代码" },
          "bars": {
            "type": "array",
            "description": "K线数组",
            "items": {
              "type": "object",
              "properties": {
                "time": { "type": "string", "description": "时间" },
                "openPrice": { "type": "number", "description": "开盘价" },
                "highPrice": { "type": "number", "description": "最高价" },
                "lowPrice": { "type": "number", "description": "最低价" },
                "closePrice": { "type": "number", "description": "收盘价" },
                "volume": { "type": "number", "description": "成交量" },
                "turnover": { "type": "number", "description": "成交额" },
                "changeRate": { "type": "number", "description": "涨跌幅 (%)" }
              }
            }
          }
        }
      }
    },
    {
      "id": "cap_depth",
      "slug": "quote.depth",
      "category": "depth",
      "displayName": "盘口深度",
      "description": "买卖盘口挂单数据 (Order Book)",
      "paramsSchema": {
        "type": "object",
        "properties": {
          "ticker": { "type": "string", "description": "股票代码" },
          "market": { "type": "string" },
          "params": {
            "type": "object",
            "properties": { "levels": { "type": "number", "description": "盘口档数，默认10" } }
          }
        },
        "required": ["ticker"]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "ticker": { "type": "string" },
          "asks": {
            "type": "array",
            "description": "卖盘（价格从低到高）",
            "items": {
              "type": "object",
              "properties": {
                "price": { "type": "number" },
                "volume": { "type": "number" },
                "numOrders": { "type": "number" }
              }
            }
          },
          "bids": {
            "type": "array",
            "description": "买盘（价格从高到低）",
            "items": {
              "type": "object",
              "properties": {
                "price": { "type": "number" },
                "volume": { "type": "number" },
                "numOrders": { "type": "number" }
              }
            }
          }
        }
      }
    },
    {
      "id": "cap_hist_kline",
      "slug": "quote.history_kline",
      "category": "kline",
      "displayName": "历史K线",
      "description": "按日期范围查询历史K线数据，无需订阅，支持分页",
      "paramsSchema": {
        "type": "object",
        "properties": {
          "ticker": { "type": "string", "description": "股票代码" },
          "market": { "type": "string" },
          "params": {
            "type": "object",
            "properties": {
              "klType": {
                "type": "number",
                "description": "K线类型: 1=1分 2=日 3=周 4=月 5=年 6=5分"
              },
              "beginTime": { "type": "string", "description": "开始时间，格式 yyyy-MM-dd" },
              "endTime": { "type": "string", "description": "结束时间，格式 yyyy-MM-dd" },
              "maxCount": { "type": "number", "description": "最大返回数量，默认1000" }
            },
            "required": ["beginTime", "endTime"]
          }
        },
        "required": ["ticker"]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "ticker": { "type": "string" },
          "bars": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": { "type": "string" },
                "openPrice": { "type": "number" },
                "highPrice": { "type": "number" },
                "lowPrice": { "type": "number" },
                "closePrice": { "type": "number" },
                "volume": { "type": "number" },
                "turnover": { "type": "number" },
                "changeRate": { "type": "number", "description": "涨跌幅 (%)" }
              }
            }
          }
        }
      }
    },
    {
