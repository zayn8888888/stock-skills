            "type": "object",
            "properties": {
              "period": { "type": "number", "description": "计算周期，默认20" },
              "indicators": {
                "type": "array",
                "items": { "type": "string" },
                "description": "指定指标: SMA, RSI, MACD, BOLL"
              }
            }
          }
        },
        "required": ["ticker"]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "ticker": { "type": "string" },
          "indicators": {
            "type": "object",
            "properties": {
              "sma": {
                "type": "object",
                "description": "简单移动平均线",
                "properties": { "value": { "type": "number" }, "period": { "type": "number" } }
              },
              "rsi": {
                "type": "object",
                "description": "相对强弱指标 (0-100)",
                "properties": { "value": { "type": "number" }, "period": { "type": "number" } }
              },
              "macd": {
                "type": "object",
                "description": "MACD",
                "properties": {
                  "macd": { "type": "number" },
                  "signal": { "type": "number" },
                  "histogram": { "type": "number" }
                }
              },
              "boll": {
                "type": "object",
                "description": "布林带",
                "properties": {
                  "upper": { "type": "number" },
                  "middle": { "type": "number" },
                  "lower": { "type": "number" }
                }
              }
            }
          }
        }
      }
